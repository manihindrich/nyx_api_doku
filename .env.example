# Copy to .env (git-ignored) and fill in values for your own test accounts.
# No inline comments: everything after "=" is the value.
NYX_API_TOKEN=
# account that owns the token
NYX_TEST_USER=TESTUSER
# second account you control: mail recipient, rights target
NYX_PEER_USER=PEERUSER
# any third user: used only to check that the guard blocks writes
NYX_OTHER_USER=OTHERUSER
# discussion owned by NYX_TEST_USER: the only write target
NYX_TEST_DISCUSSION=100001
# someone else's public discussion: read only
NYX_PUBLIC_DISCUSSION=100002
# a post by NYX_PEER_USER in the test discussion (rating tests)
NYX_PEER_POST=50000013
# a header section of the test discussion (saved, then restored)
NYX_HEADER_ITEM=60004
